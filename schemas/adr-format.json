{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adr-format.json",
  "title": "Architecture Decision Record",
  "description": "Format for ADR documents.",
  "type": "object",
  "required": ["number", "title", "status", "context", "decision", "consequences"],
  "additionalProperties": false,
  "properties": {
    "number": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["proposed", "accepted", "deprecated", "superseded"] },
    "context": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "minLength": 1 },
    "consequences": { "type": "string", "minLength": 1 },
    "date": { "type": "string" },
    "superseded_by": { "type": "integer", "minimum": 1 },
    "workload_assumptions": { "type": "object", "description": "Constraint-sheet workload dimension from constraint-sheet.json" },
    "revisit_trigger": { "type": "string", "description": "Observable condition that would invalidate this decision" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "date": { "type": "string" },
          "version": { "type": "string" },
          "applicability": { "type": "string" }
        }
      },
      "description": "Research evidence with provenance from constraint-sheet.json"
    }
  }
}
