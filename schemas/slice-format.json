{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slice-format.json",
  "title": "Implementation Slice",
  "description": "Format for a single implementation slice in a breakdown.",
  "type": "object",
  "required": ["number", "name", "description", "autonomy", "done_when", "files", "dependencies"],
  "additionalProperties": false,
  "properties": {
    "number": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "autonomy": { "type": "string", "enum": ["afk", "hitl"] },
    "done_when": { "type": "string", "minLength": 1 },
    "files": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "adr_refs": { "type": "array", "items": { "type": "string" } }
  }
}
